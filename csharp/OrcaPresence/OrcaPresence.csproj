<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>OrcaPresence</AssemblyName>
    <RootNamespace>OrcaPresence</RootNamespace>
    <!-- Why: the exe icon comes from the .ico generated out of orca-rpc.png. -->
    <ApplicationIcon>../../build/app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Why embedded: the shipped exe must carry its tray icon itself, with no loose files. -->
    <EmbeddedResource Include="../../build/app.ico" LogicalName="OrcaPresence.app.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- Why net48: the in-box framework, so no runtime install is needed on the user's machine. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Why a package: System.Text.Json is inbox from .NET Core 3.0 on, but not on .NET Framework. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
</Project>
