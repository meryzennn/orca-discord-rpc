{
  "name": "orca-discord-rpc",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "description": "Discord Rich Presence for Orca — reflects the active worktree and running agent.",
  "license": "MIT",
  "author": {
    "name": "meryzennn"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "orca-discord-rpc": "./src/cli.ts"
  },
  "scripts": {
    "start": "node src/cli.ts start",
    "stop": "node src/cli.ts stop",
    "status": "node src/cli.ts status",
    "test": "node --test \"src/*.test.ts\" \"config/scripts/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "icons": "node config/scripts/build-ico.mjs",
    "build:csharp": "node config/scripts/build-ico.mjs && dotnet publish csharp/OrcaPresence -c Release -o dist-csharp",
    "pack:csharp": "node config/scripts/pack-zip.mjs"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2"
  }
}
